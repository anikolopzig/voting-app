# dependencies (node_modules matches at any depth: frontend/, backend/)
node_modules
.pnp
.pnp.js

# Firebase — local emulator/secret state (never commit the Gemini key)
.firebase
backend/.secret.local

# build output + Vite's local cache
dist
dist-ssr
.vite

# local env files — NEVER commit real Firebase keys
.env
.env.local
.env.*.local

# logs (firebase-debug.log, database-debug.log, ui-debug.log … are emulator output)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*-debug.log

# Claude Code — share .claude/commands/, keep machine-local settings out
.claude/settings.local.json

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

{
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "function": { "functionId": "suggestOptions", "region": "us-central1" }
      },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": {
    "source": "backend"
  }
}

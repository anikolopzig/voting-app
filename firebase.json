{
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/suggest",
        "function": { "functionId": "suggestOptions", "region": "us-central1" }
      },
      {
        "source": "/api/expand",
        "function": { "functionId": "expandOptions", "region": "us-central1" }
      },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "img-src 'self' data: https://upload.wikimedia.org; frame-src 'none'; object-src 'none'"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "backend"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "ui": { "enabled": true },
    "singleProjectMode": true
  }
}

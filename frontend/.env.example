# ----------------------------------------------------------------------------
# Firebase configuration
#
# 1. Copy this file to `.env`  ->  cp .env.example .env
# 2. Fill in the values from your Firebase project's web-app config.
#    (Firebase Console -> Project settings -> General -> "Your apps" -> SDK setup.)
# 3. Restart `npm run dev` after editing `.env` (Vite only reads env at startup).
#
# NOTE: All variables MUST be prefixed with VITE_ to be exposed to the client.
#       These are browser-visible by design — Firebase web keys are not secrets,
#       your database is protected by Realtime Database security rules instead.
#
# The Gemini API key for AI option suggestions is deliberately NOT here. It is
# a real secret and must NEVER be a VITE_ var (those are inlined into the public
# browser bundle). It lives server-side as a Firebase secret used by the Cloud
# Function in backend/ — set it with:
#     firebase functions:secrets:set GEMINI_API_KEY
# and, for the local emulator, put GEMINI_API_KEY=... in backend/.secret.local
# (gitignored). See README.md → "AI option suggestions".
# ----------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890
